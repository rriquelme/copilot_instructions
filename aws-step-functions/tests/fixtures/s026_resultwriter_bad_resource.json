{
 "QueryLanguage": "JSONata",
 "StartAt": "M",
 "States": {
  "M": {
   "Type": "Map",
   "ItemProcessor": {
    "ProcessorConfig": {
     "Mode": "DISTRIBUTED",
     "ExecutionType": "STANDARD"
    },
    "StartAt": "P",
    "States": {
     "P": {
      "Type": "Pass",
      "End": true
     }
    }
   },
   "Items": "{% $states.input.items %}",
   "End": true,
   "ResultWriter": {
    "Resource": "arn:aws:states:::s3:getObject",
    "Arguments": {
     "Bucket": "b",
     "Prefix": "p"
    }
   }
  }
 }
}
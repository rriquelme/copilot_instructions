{
  "StartAt": "Approve",
  "States": {
    "Approve": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "TimeoutSeconds": 3600,
      "TimeoutSecondsPath": "$.approvalTimeout",
      "HeartbeatSeconds": 60,
      "HeartbeatSecondsPath": "$.heartbeat",
      "Parameters": {"QueueUrl": "https://sqs.us-east-1.amazonaws.com/123456789012/q", "MessageBody": {"token.$": "$$.Task.Token"}},
      "End": true
    }
  }
}

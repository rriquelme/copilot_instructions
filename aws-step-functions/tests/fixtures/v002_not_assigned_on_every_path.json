{
  "QueryLanguage": "JSONata",
  "StartAt": "Route",
  "States": {
    "Route": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $states.input.vip %}",
          "Assign": {
            "tier": "gold"
          },
          "Next": "Use"
        }
      ],
      "Default": "Use"
    },
    "Use": {
      "Type": "Map",
      "Items": "{% $states.input.items %}",
      "Output": "{% $tier %}",
      "ItemProcessor": {
        "StartAt": "Inner",
        "States": {
          "Inner": {
            "Type": "Pass",
            "Assign": {
              "inner": 1
            },
            "End": true
          }
        }
      },
      "Next": "After"
    },
    "After": {
      "Type": "Pass",
      "Output": "{% $inner %}",
      "End": true
    }
  }
}

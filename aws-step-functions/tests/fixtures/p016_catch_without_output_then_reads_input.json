{
 "QueryLanguage": "JSONata",
 "StartAt": "T",
 "States": {
  "T": {
   "Type": "Task",
   "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
   "Arguments": {
    "Bucket": "b",
    "Key": "k"
   },
   "Catch": [
    {
     "ErrorEquals": [
      "States.ALL"
     ],
     "Next": "H"
    }
   ],
   "Next": "H"
  },
  "H": {
   "Type": "Pass",
   "Output": "{% $states.input.orderId %}",
   "End": true
  }
 }
}
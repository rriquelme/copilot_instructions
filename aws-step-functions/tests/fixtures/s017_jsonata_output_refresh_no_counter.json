{
  "QueryLanguage": "JSONata",
  "StartAt": "Get",
  "States": {
    "Get": {"Type": "Task", "Resource": "arn:aws:states:::aws-sdk:glue:getJobRun",
      "Arguments": {"JobName": "j", "RunId": "{% $states.input.runId %}"},
      "Output": {"runId": "{% $states.input.runId %}", "state": "{% $states.result.JobRun.JobRunState %}"}, "Next": "Check"},
    "Check": {"Type": "Choice", "Choices": [{"Condition": "{% $states.input.state = 'SUCCEEDED' %}", "Next": "Done"}], "Default": "Get"},
    "Done": {"Type": "Succeed"}
  }
}

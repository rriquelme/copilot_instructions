{
  "Comment": "Distributed Map over a CSV in S3, batched, Express children, results exported to S3 (JSONata)",
  "QueryLanguage": "JSONata",
  "StartAt": "ProcessOrders",
  "States": {
    "ProcessOrders": {
      "Type": "Map",
      "Label": "OrderBatches",
      "ItemReader": {
        "Resource": "arn:aws:states:::s3:getObject",
        "ReaderConfig": {"InputType": "CSV", "CSVHeaderLocation": "FIRST_ROW", "CSVDelimiter": "SEMICOLON", "MaxItems": 100000},
        "Arguments": {"Bucket": "{% $states.input.bucket %}", "Key": "{% $states.input.key %}"}
      },
      "ItemBatcher": {
        "MaxItemsPerBatch": 100,
        "MaxInputBytesPerBatch": 262144,
        "BatchInput": {"runId": "{% $states.context.Execution.Name %}"}
      },
      "MaxConcurrency": 500,
      "ToleratedFailurePercentage": 5,
      "ToleratedFailureCount": 10,
      "ItemProcessor": {
        "ProcessorConfig": {"Mode": "DISTRIBUTED", "ExecutionType": "EXPRESS"},
        "StartAt": "HandleBatch",
        "States": {
          "HandleBatch": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Arguments": {
              "FunctionName": "arn:aws:lambda:us-east-1:123456789012:function:handle-orders",
              "Payload": {"orders": "{% $states.input.Items %}", "runId": "{% $states.input.BatchInput.runId %}"}
            },
            "Retry": [
              {"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
               "IntervalSeconds": 1, "MaxAttempts": 3, "BackoffRate": 2, "JitterStrategy": "FULL"}
            ],
            "TimeoutSeconds": 120,
            "Output": "{% $states.result.Payload %}",
            "Next": "Settle"
          },
          "Settle": {"Type": "Wait", "Seconds": 30, "Next": "Done"},
          "Done": {"Type": "Succeed"}
        }
      },
      "ResultWriter": {
        "Resource": "arn:aws:states:::s3:putObject",
        "Arguments": {"Bucket": "order-results", "Prefix": "runs/"},
        "WriterConfig": {"Transformation": "FLATTEN", "OutputType": "JSONL"}
      },
      "End": true
    }
  }
}

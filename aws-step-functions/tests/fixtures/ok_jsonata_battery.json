{
  "Comment": "Battery of valid JSONata 2.0 expressions (verified with jsonata-python); must lint clean.",
  "QueryLanguage": "JSONata",
  "StartAt": "Init",
  "States": {
    "Init": {
      "Type": "Pass",
      "Assign": {
        "name": "Bob",
        "n": 4,
        "größe": 3
      },
      "Next": "Battery"
    },
    "Battery": {
      "Type": "Pass",
      "Output": {
        "e000": "{% $states.input.items[$.price > 10] %}",
        "e001": "{% $states.input.items.{ \"id\": $.id } %}",
        "e002": "{% $states.input.orders.( $.total * 2 ) %}",
        "e003": "{% $states.input ~> |$.items|{\"done\": true}| %}",
        "e004": "{% $states.input ~> | items | {\"done\": true}, [\"qty\"] | %}",
        "e005": "{% $states.input.items[$.price > 10 and $.qty < 5].{ \"id\": $.id, \"total\": $.price * $.qty } %}",
        "e006": "{% $map($states.input.items, function($v){ $v.price }) %}",
        "e007": "{% $states.input.list[$ = \"a\"] %}",
        "e008": "{% $states.input.items[price > $$.min].id %}",
        "e009": "{% $states.input.items[$.price > $$.min].id %}",
        "e010": "{% $map($states.input.ids, $string) %}",
        "e011": "{% $states.input.name ~> $uppercase %}",
        "e012": "{% $map($states.input.names, $trim) %}",
        "e013": "{% $filter($states.input.flags, $boolean) %}",
        "e014": "{% $states.input.nums ~> $distinct %}",
        "e015": "{% $states.input.flags ~> $map($boolean) %}",
        "e016": "{% $replace($states.input.key, /[^/]+$/, \"x\") %}",
        "e017": "{% $match($states.input.key, /^([^/]+)\\/(.*)$/) %}",
        "e018": "{% $match($states.input.s, /a\\/b/i) %}",
        "e019": "{% $split($states.input.csv, /,\\s*/) %}",
        "e020": "{% $contains($states.input.s, /[a-z]+/) %}",
        "e021": "{% $states.input.b / $states.input.n %}",
        "e022": "{% $n / 2 %}",
        "e023": "{% ($n)/2 %}",
        "e024": "{% $states.input.n/2 %}",
        "e025": "{% $states.input.items[0].price / $n %}",
        "e026": "{% $exists($states.input.a) ? $states.input.a : 0 %}",
        "e027": "{% $states.input.a ? $states.input.a : \"none\" %}",
        "e028": "{% $states.input.n != 1 %}",
        "e029": "{% $states.input.n > 1 ? \"big\" : \"small\" %}",
        "e030": "{% $states.input.n % 3 %}",
        "e031": "{% $states.input.n in [1, 2, 7] %}",
        "e032": "{% $exists($states.input.a) and $states.input.n >= 1 or $states.input.n <= 0 %}",
        "e033": "{% -$states.input.n + $abs(-5) %}",
        "e034": "{% \"a\\\"b\" & $name & 'it\"s /x/' & \"\\u00e9\\\\\" %}",
        "e035": "{% $string($states.input.n * 100) & \"%\" %}",
        "e036": "{% \"rate: 50%\" & $name %}",
        "e037": "{% [1..5] %}",
        "e038": "{% [1..$n] %}",
        "e039": "{% $states.input.items[[0..1]].id %}",
        "e040": "{% $states.input.items@$it.{ \"id\": $it.id } %}",
        "e041": "{% $states.input.items#$pos.{ \"pos\": $pos, \"id\": id } %}",
        "e042": "{% $states.input.items^(price).id %}",
        "e043": "{% $states.input.items^(>price, <id).name %}",
        "e044": "{% $states.input.**.sku %}",
        "e045": "{% $states.input.orders.items.{ \"o\": %.id } %}",
        "e046": "{% $states.input.items{ name: $sum(price) } %}",
        "e047": "{% $states.input.name ~> $substring(0, 2) ~> $uppercase() %}",
        "e048": "{% $states.input.nums ~> $sort() ~> $reverse() %}",
        "e049": "{% $states.input.items ~> $filter(function($v){ $v.price > 10 }) ~> $count() %}",
        "e050": "{% $states.input.items.name ~> $join(\",\") %}",
        "e051": "{% $states.input.`first name` %}",
        "e052": "{% $states.input.ünïcode & $größe %}",
        "e053": "{% { \"$notAVar\": $name, \"b\": [$name, $n] } %}",
        "e054": "{% /* $commentVar is not read */ $name %}",
        "e055": "{% ( $a := 1; $b := $a + 1; $b ) %}",
        "e056": "{% ( $inc := function($x){ $x + 1 }; $map([1, 2], $inc) ) %}",
        "e057": "{% ( $f := $substring(?, 0, 2); $f(\"abcd\") ) %}",
        "e058": "{% function($x){ $x * 2 }(3) %}",
        "e059": "{% $map([1, 2], function($v, $i){ $v + $i }) %}",
        "e060": "{% $map($states.input.ids, function($v){ $states.input.n + $v }) %}",
        "e061": "{% $each($states.input.obj, function($v, $k){ $k & \"=\" & $v }) %}",
        "e062": "{% $reduce($states.input.nums, function($acc, $v){ $acc + $v }, 0) %}",
        "e063": "{% $sift($states.input.obj, function($v){ $v > 1 }) %}",
        "e064": "{% $single($states.input.items, function($v){ $v.id = 1 }) %}",
        "e065": "{% $sort($states.input.nums, function($l, $r){ $l > $r }) %}",
        "e066": "{% $map($states.input.items, function($v)<o:n>{ $v.price * 2 }) %}",
        "e067": "{% $states.input.items.(function($p)<n:n>{ $p * 2 }($.price)) %}",
        "e068": "{% $states.input.items@$i[$i.price > 1].id %}",
        "e069": "{% $states.input.n.$number() + $states.input.list[$string() = \"a\"].$length() %}",
        "e070": "{% $states.input.names.$uppercase() %}",
        "e071": "{% $states.input.n.$string() %}",
        "e072": "{% $states.input.names[$contains(\"b\")] %}",
        "e073": "{% $states.input.names[$length($) > 2] %}",
        "e074": "{% $states.input.items[$contains(name, \"a\")].id %}",
        "e075": "{% $lookup($states.input.obj, \"p\") %}",
        "e076": "{% $sum($states.input.items.price) %}",
        "e077": "{% $join($states.input.names, \", \") %}",
        "e078": "{% $keys($states.input.obj) %}",
        "e079": "{% $merge([$states.input.obj, {\"x\": 1}]) %}",
        "e080": "{% $formatNumber($states.input.n, \"#,##0.00\") %}",
        "e081": "{% $fromMillis($millis(), \"[Y0001]-[M01]-[D01]\") %}",
        "e082": "{% $toMillis(\"2024-01-01T00:00:00Z\") %}",
        "e083": "{% $power(2, 3) + $round(3.14159, 2) %}",
        "e084": "{% $zip([1, 2], [3, 4], [5, 6]) %}",
        "e085": "{% $type($states.input.n) %}",
        "e086": "{% $base64encode($name) %}",
        "e087": "{% $states.input.items[price > 10][0].name %}",
        "e088": "{% $states.input.items[-1].id %}",
        "e089": "{% $states.input.context ? 1 : 0 %}",
        "e090": "{% $states.context.Execution.Id %}",
        "e091": "{% $uuid() %}",
        "e092": "{% $partition([1, 2, 3], 2) %}",
        "e093": "{% $range(0, 10, 2) %}",
        "e094": "{% $hash($name, \"SHA-256\") %}",
        "e095": "{% $parse(\"{\\\"a\\\": 1}\") %}"
      },
      "End": true
    }
  }
}

{
 "Comment": "Iterator State Machine Example",
 "StartAt": "ConfigureCount",
 "States": {
  "ConfigureCount": {
   "Type": "Pass",
   "Next": "Iterator",
   "Parameters": {
    "iterator": {
     "count": 10,
     "index": 0,
     "step": 1
    },
    "data.$": "$"
   }
  },
  "Iterator": {
   "Type": "Task",
   "Resource": "arn:aws:lambda:us-east-1:123456789012:function:Iterate",
   "ResultPath": "$.iterator",
   "Next": "IsCountReached"
  },
  "IsCountReached": {
   "Type": "Choice",
   "Choices": [
    {
     "Variable": "$.iterator.continue",
     "BooleanEquals": true,
     "Next": "ExampleWork"
    }
   ],
   "Default": "Done"
  },
  "ExampleWork": {
   "Comment": "Your application logic, to run a specific number of times",
   "Type": "Pass",
   "Result": {
    "success": true
   },
   "ResultPath": "$.result",
   "Next": "Iterator"
  },
  "Done": {
   "Type": "Pass",
   "End": true
  }
 }
}
{
  "QueryLanguage": "JSONata",
  "StartAt": "Get",
  "States": {
    "Get": {
      "Type": "Task",
      "Comment": "Poll the Glue run. lint-allow S017, S018: the job is rate limited upstream and finishes within 3 polls",
      "Resource": "arn:aws:states:::aws-sdk:glue:getJobRun",
      "Arguments": {
        "JobName": "j",
        "RunId": "r"
      },
      "Assign": {
        "status": "{% $states.result.JobRun.JobRunState %}"
      },
      "Next": "Check"
    },
    "Check": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $status = 'SUCCEEDED' %}",
          "Next": "Done"
        }
      ],
      "Default": "Get"
    },
    "Done": {
      "Type": "Succeed"
    }
  }
}

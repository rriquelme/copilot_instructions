{
  "QueryLanguage": "JSONata",
  "StartAt": "GetOrder",
  "States": {
    "GetOrder": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {"FunctionName": "get-order", "Payload": "{% $states.input %}"},
      "Output": "{% $states.result.Payload %}",
      "Assign": {"orderId": "{% $states.result.Payload.id %}"},
      "TimeoutSeconds": 30,
      "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 1, "MaxAttempts": 3, "BackoffRate": 2, "JitterStrategy": "FULL"}],
      "Next": "ChargeOrdr"
    },
    "ChargeOrder": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {"FunctionName": "charge", "Payload": {"id": "{% $orderId %}"}},
      "Output": "{% $states.result.Payload %}",
      "TimeoutSeconds": 30,
      "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 1, "MaxAttempts": 3, "BackoffRate": 2, "JitterStrategy": "FULL"}],
      "Next": "Done"
    },
    "Done": {"Type": "Succeed"}
  }
}

{
  "StartAt": "Submit",
  "States": {
    "Submit": {"Type": "Task", "Resource": "arn:aws:lambda:us-east-1:123456789012:function:SubmitJob", "ResultPath": "$.guid", "Next": "GetStatus"},
    "GetStatus": {"Type": "Task", "Resource": "arn:aws:lambda:us-east-1:123456789012:function:CheckJob", "ResultPath": "$.status", "Next": "IsDone"},
    "IsDone": {
      "Type": "Choice",
      "Choices": [{"Variable": "$.status", "StringEquals": "SUCCEEDED", "Next": "Done"}],
      "Default": "GetStatus"
    },
    "Done": {"Type": "Succeed"}
  }
}

{
  "Comment": "Copy a report across accounts with AWS SDK integrations",
  "QueryLanguage": "JSONata",
  "Version": "1.0",
  "TimeoutSeconds": 3600,
  "StartAt": "Read report",
  "States": {
    "Read report": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
      "Credentials": {"RoleArn": "arn:aws:iam::111122223333:role/ReportReader"},
      "Arguments": {"Bucket": "reports-src", "Key": "{% $states.input.key %}"},
      "TimeoutSeconds": 300,
      "HeartbeatSeconds": 60,
      "Retry": [
        {"ErrorEquals": ["S3.SlowDownException"], "IntervalSeconds": 2, "MaxAttempts": 5, "BackoffRate": 2, "MaxDelaySeconds": 30, "Comment": "throttling"},
        {"ErrorEquals": ["States.Timeout"], "IntervalSeconds": 10, "MaxAttempts": 99999999}
      ],
      "Catch": [
        {"ErrorEquals": ["S3.NoSuchKeyException"], "Comment": "nothing to copy", "Next": "Nothing to copy"}
      ],
      "Output": {"key": "{% $states.input.key %}", "body": "{% $states.result.Body %}"},
      "Next": "Pause"
    },
    "Pause": {
      "Type": "Wait",
      "Seconds": 5,
      "Next": "Write report"
    },
    "Write report": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
      "Arguments": {"Bucket": "reports-dst", "Key": "{% $states.input.key %}", "Body": "{% $states.input.body %}", "ContentType": "text/csv"},
      "Next": "Summarize"
    },
    "Summarize": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:lambda:invoke",
      "Arguments": {"FunctionName": "summarize-report", "Payload": "{% $string($states.input) %}"},
      "Retry": [
        {"ErrorEquals": ["Lambda.TooManyRequestsException"], "IntervalSeconds": 1, "MaxAttempts": 3}
      ],
      "Output": "{% $parse($states.result.Payload) %}",
      "End": true
    },
    "Nothing to copy": {
      "Type": "Succeed",
      "Comment": "the source object does not exist"
    }
  }
}

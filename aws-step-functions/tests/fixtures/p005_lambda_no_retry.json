{
  "QueryLanguage": "JSONata",
  "StartAt": "NoRetry",
  "States": {
    "NoRetry": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "f"
      },
      "Output": "{% $states.result.Payload %}",
      "Next": "WrongRetry"
    },
    "WrongRetry": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:123456789012:function:fn",
      "End": true,
      "Retry": [
        {
          "ErrorEquals": [
            "MyError"
          ]
        }
      ]
    }
  }
}
{
 "QueryLanguage": "JSONata",
 "StartAt": "Q",
 "States": {
  "Q": {
   "Type": "Task",
   "Resource": "arn:aws:states:::lambda:invokeAsync",
   "Arguments": {
    "FunctionName": "f"
   },
   "Retry": [
    {
     "ErrorEquals": [
      "Lambda.ServiceException",
      "Lambda.TooManyRequestsException"
     ],
     "MaxAttempts": 2
    }
   ],
   "End": true
  }
 }
}